<pdf:Keywords>epilepsy, SEEG, complex-valued phase-amplitude coupling, complex-valued convolutional neural network, epileptogenic zone</pdf:Keywords>
</rdf:Description>
<rdf:Description rdf:about="">
<dc:identifier></dc:identifier>
<dc:title>Classifying epileptic phase-amplitude coupling in SEEG using complex-valued convolutional neural network</dc:title>
<prism:doi></prism:doi>
<prism:url></prism:url>
<dc:creator><rdf:Bag><rdf:li>Chunsheng Li</rdf:li>
<rdf:li>Shiyue Liu</rdf:li>
<rdf:li>Zeyu Wang</rdf:li>
<rdf:li>Guanqian Yuan</rdf:li>
</rdf:Bag></dc:creator>
<dc:description>EEG phase-amplitude coupling (PAC), the amplitude of high-frequency oscillations modulated by the phase of low-frequency oscillations (LFOs), is a useful biomarker to localize epileptogenic tissue.</dc:description>
<dc:subject><rdf:Bag><rdf:li>epilepsy</rdf:li><rdf:li>SEEG</rdf:li><rdf:li>complex-valued phase-amplitude coupling</rdf:li><rdf:li>complex-valued convolutional neural network</rdf:li><rdf:li>epileptogenic zone</rdf:li></rdf:Bag></dc:subject>
<dc:source></dc:source>
